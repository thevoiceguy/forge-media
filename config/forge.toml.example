# Forge Media Engine Configuration Example
#
# Copy this file to forge.toml and customize as needed.
# The engine will look for config in these locations (in order):
#   1. /etc/forge/config.toml
#   2. ./config/forge.toml
#   3. ./forge.toml

# ============================================================================
# API Server Configuration
# ============================================================================
[api]
# HTTP API server bind address
http_bind = "0.0.0.0:8080"

# HTTPS configuration (optional)
enable_https = false
# https_bind = "0.0.0.0:8443"
# tls_cert = "/path/to/cert.pem"
# tls_key = "/path/to/key.pem"

# CORS configuration
enable_cors = true
cors_origins = ["http://localhost:3000", "https://your-frontend.example.com"]

# Authentication tokens (empty = no auth, not recommended for production)
# Generate secure tokens: openssl rand -hex 32
auth_tokens = [
    # "your-secret-token-here",
]

# Rate limiting (per IP address)
rate_limit_requests_per_window = 120  # Max requests
rate_limit_window_secs = 60            # Time window in seconds

# Recording base directory
# All recording paths are constrained within this directory
recording_base_dir = "/var/lib/forge/recordings"

# ============================================================================
# Media Engine Configuration
# ============================================================================
[engine]
# RTP/RTCP port allocation range
# Ensure this range is open in your firewall
port_range_start = 30000
port_range_end = 40000

# Session timeout in seconds
# Sessions idle longer than this will be automatically terminated
session_timeout_secs = 300

# TOS/DSCP value for QoS marking
# Common values:
#   0xB8 (184) = EF (Expedited Forwarding) - recommended for voice
#   0xAF (175) = AF41 - high priority
#   0x00 (0)   = Best effort (default)
tos = 184

# IP version configuration
# Options: "ipv4_only", "ipv6_only", "dual_stack"
ip_version = "dual_stack"

# Network interfaces (optional, for multi-homed servers)
# [[engine.interfaces]]
# name = "eth0"
# address = "192.168.1.100"
# advertised_address = "203.0.113.100"  # Public IP for NAT scenarios

# ============================================================================
# XDP/eBPF Acceleration Configuration
# ============================================================================
[engine.xdp]
# Enable XDP/eBPF for high-performance packet forwarding
#
# Benefits:
#   - Sub-10µs packet forwarding latency (vs ~75µs userspace)
#   - 10x higher throughput (500k+ PPS per core)
#   - 75% reduction in CPU usage for media forwarding
#
# Requirements:
#   - Linux kernel >= 5.4
#   - Compiled with 'xdp' feature: cargo build --features xdp
#   - Root/CAP_BPF privileges to load eBPF programs
#
# Note: XDP only accelerates RTP forwarding after endpoints are learned.
#       Signaling, RTCP, and control plane remain in userspace.
enabled = false

# Network interface to attach XDP program
#
# Development/Testing: Use "lo" (loopback)
# Production: Use your primary network interface
#   - Find with: ip link show
#   - Common names: "eth0", "ens3", "enp0s3", etc.
interface = "lo"

# XDP mode
#
# Options:
#   "generic" (XDP_SKB):
#     - Software-based XDP
#     - Works on all network interfaces
#     - Latency: ~50-100µs (still better than userspace ~75µs)
#     - Good for: Testing, compatibility, older NICs
#
#   "native" (XDP_DRV):
#     - Driver-based XDP (requires NIC support)
#     - Hardware offload at NIC level
#     - Latency: <10µs (best performance)
#     - Good for: Production with modern NICs
#     - Supported NICs: Intel i40e, ixgbe, mlx5, virtio_net, etc.
#
# Recommendation: Start with "generic", upgrade to "native" in production
mode = "generic"

# Fallback to userspace forwarding if XDP fails to load
#
# If true: System works normally even if XDP unavailable
# If false: Fail fast if XDP cannot be loaded
#
# Recommendation: true (for maximum compatibility)
fallback = true

# ============================================================================
# AI Session Persistence & Recovery Configuration
# ============================================================================
[engine.ai_persistence]
# Enable AI session persistence for automatic recovery after server restarts
#
# Benefits:
#   - Sessions survive server crashes/restarts
#   - Automatic reconnection with exponential backoff
#   - Preserves conversation context
#   - Health checks and graceful degradation
#
# When disabled, AI sessions are lost on server restart
enabled = false

# Persistence backend type
#
# Options:
#   "disk":  JSON files on local filesystem (simple, no dependencies)
#   "redis": Redis key-value store (recommended for production, multi-server)
#
# Disk backend:
#   - Good for: Single-server deployments, development
#   - Pros: No external dependencies, simple
#   - Cons: Not shared across servers
#
# Redis backend:
#   - Good for: Production, load-balanced deployments
#   - Pros: Shared state, TTL expiration, high availability
#   - Cons: Requires Redis server
#   - Note: Compile with 'persistence-redis' feature
backend = "disk"

# Disk persistence directory (used when backend = "disk")
disk_path = "/var/lib/forge/ai-sessions"

# Redis configuration (used when backend = "redis")
#
# Format: "redis://[<username>][:<password>@]<hostname>[:port][/<db>]"
# Examples:
#   - redis://localhost:6379
#   - redis://:password@localhost:6379
#   - redis://user:password@redis.example.com:6379/0
# redis_url = "redis://localhost:6379"

# Redis key prefix (prevents collisions in shared Redis)
redis_key_prefix = "forge:ai:session:"

# Redis TTL (time-to-live) in seconds
# Sessions older than this are automatically expired
redis_ttl_secs = 86400  # 24 hours

# Maximum reconnection attempts before marking session as failed
#
# Uses exponential backoff: 1s → 2s → 4s → 8s → 16s → 32s → 60s (max)
# Example with max_reconnect_attempts = 10:
#   - Total retry time: ~2 minutes
#   - Attempt 1: 1 second
#   - Attempt 2: 2 seconds
#   - Attempt 3: 4 seconds
#   - ...
#   - Attempt 7+: 60 seconds (capped)
max_reconnect_attempts = 10

# Health check interval in seconds
#
# Periodically checks:
#   - Persistence backend availability (disk writable, Redis PING)
#   - Disconnected sessions for automatic reconnection
health_check_interval_secs = 30

# Enable automatic reconnection on connection loss
#
# When true: Automatically attempt to reconnect disconnected sessions
# When false: Mark as disconnected but don't auto-reconnect (manual intervention)
auto_reconnect = true

# ============================================================================
# AI Persistence Example Configurations
# ============================================================================
#
# Example 1: Disk-based persistence (simple, single-server)
# [engine.ai_persistence]
# enabled = true
# backend = "disk"
# disk_path = "/var/lib/forge/ai-sessions"
# max_reconnect_attempts = 10
# health_check_interval_secs = 30
# auto_reconnect = true
#
# Example 2: Redis-based persistence (production, multi-server)
# [engine.ai_persistence]
# enabled = true
# backend = "redis"
# redis_url = "redis://localhost:6379"
# redis_key_prefix = "forge:ai:session:"
# redis_ttl_secs = 86400
# max_reconnect_attempts = 10
# health_check_interval_secs = 30
# auto_reconnect = true
#
# Example 3: High-availability Redis with authentication
# [engine.ai_persistence]
# enabled = true
# backend = "redis"
# redis_url = "redis://:your-password@redis-ha.example.com:6379/0"
# redis_key_prefix = "prod:forge:ai:"
# redis_ttl_secs = 172800  # 48 hours
# max_reconnect_attempts = 20  # More aggressive retries
# health_check_interval_secs = 15  # More frequent checks
# auto_reconnect = true

# ============================================================================
# Production Example Configuration
# ============================================================================
#
# For production deployment on a dedicated media server:
#
# [api]
# http_bind = "0.0.0.0:8080"
# enable_https = true
# https_bind = "0.0.0.0:8443"
# tls_cert = "/etc/forge/certs/fullchain.pem"
# tls_key = "/etc/forge/certs/privkey.pem"
# auth_tokens = ["your-secure-token-here"]
# recording_base_dir = "/var/lib/forge/recordings"
#
# [engine]
# port_range_start = 30000
# port_range_end = 40000
# tos = 184
#
# [engine.xdp]
# enabled = true
# interface = "eth0"  # Your primary NIC
# mode = "native"     # For best performance
# fallback = true
#
# [engine.ai_persistence]
# enabled = true
# backend = "redis"
# redis_url = "redis://localhost:6379"
# max_reconnect_attempts = 10
# health_check_interval_secs = 30
# auto_reconnect = true
